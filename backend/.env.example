# Proyecto Supabase "lead-core"
SUPABASE_URL=https://<project-ref>.supabase.co
# Secret key (sb_secret_...): solo en el backend, NUNCA en el frontend ni en git
SUPABASE_SECRET_KEY=
# Conexión Postgres por el pooler en modo transacción (puerto 6543)
DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres

# Validación de JWT: si el proyecto usa claves asimétricas (recomendado), deja vacío
# y el backend usa el JWKS. Si usa el secreto legacy HS256, ponlo aquí.
SUPABASE_JWT_SECRET=

# Orígenes permitidos (frontend Next.js), separados por coma
CORS_ORIGINS=http://localhost:3000,https://talent.leadmindset.org
