# Proyecto Supabase "lead-core"
SUPABASE_URL=https://<project-ref>.supabase.co
# Secret key (sb_secret_...): solo en el backend, NUNCA en el frontend ni en git
SUPABASE_SECRET_KEY=
# Conexión Postgres por el pooler en modo transacción (puerto 6543)
DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres

# Validación de JWT: si el proyecto usa claves asimétricas (recomendado), deja vacío
# y el backend usa el JWKS. Si usa el secreto legacy HS256, ponlo aquí.
SUPABASE_JWT_SECRET=

# Orígenes permitidos (frontend Next.js), separados por coma
CORS_ORIGINS=http://localhost:3000,https://talent.leadmindset.org

#Foundry AI agent
AZURE_TENANT_ID=el Directory (tenant) ID
AZURE_CLIENT_ID=el Application (client) ID
AZURE_CLIENT_SECRET=el Value del secret
FOUNDRY_ENDPOINT=la URL del paso 3
FOUNDRY_DEPLOYMENT=cv-parser
# Opcional. Versión de la API de Azure OpenAI (por defecto 2025-04-01-preview)
FOUNDRY_API_VERSION=

# Ambiente: local en tu máquina. Cualquier otro valor se trata como desplegado
# (sin /docs, /redoc ni /openapi.json, y sin LOG_CV_DEBUG)
ENV=
# true registra el texto extraído del CV en los logs. Solo funciona si ENV=local
LOG_CV_DEBUG=

# Application Insights (todavía no se usa)
APPLICATIONINSIGHTS_CONNECTION_STRING=
