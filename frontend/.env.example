# Proyecto Supabase (lead-core o lead-core-qa)
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
# Publishable key (sb_publishable_...). Es pública: puede ir en el navegador.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Backend FastAPI
NEXT_PUBLIC_API_URL=http://localhost:8000
# Login con Google: "true" lo muestra en login y sign-up. Vacío u otro valor lo apaga.
# Queda fijo al compilar: si lo cambias en Vercel, haz redeploy.
NEXT_PUBLIC_AUTH_GOOGLE_ENABLED=
